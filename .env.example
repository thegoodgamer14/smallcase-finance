# Copy to .env and fill in (never commit .env)
#   cp .env.example .env

# ── Upstox historical prices (optional) ─────────────────────────────────────
# Bearer access token from the Upstox developer console / OAuth login.
# Either variable works; ACCESS_TOKEN is preferred.
UPSTOX_ACCESS_TOKEN=
# UPSTOX_API_KEY=

# Optional overrides
# UPSTOX_API_BASE=https://api.upstox.com/v2
# UPSTOX_DEFAULT_YEARS=3

# Enable POST /integrations/upstox/sync (local only; prefer CLI)
# UPSTOX_SYNC_ENABLED=0

# ── App ─────────────────────────────────────────────────────────────────────
# DATA_CURATED_ROOT=
# DEFAULT_RF=0.0
# PERIODS_PER_YEAR=252
