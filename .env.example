# Copy to .env and fill in (never commit .env)
#   cp .env.example .env
#
# Repo is PUBLIC — never put real tokens/secrets in git.
# Upstox portal: https://account.upstox.com/developer/apps
# Auth docs:    https://upstox.com/developer/api-documentation/authentication
# Get Token:    https://upstox.com/developer/api-documentation/get-token

# ── Upstox (sole historical OHLCV source — ADR 005) ─────────────────────────
# Bearer access token from Developer Apps → Generate (or OAuth token exchange).
# Tokens expire ~3:30 AM IST the following day; re-generate when expired.
UPSTOX_ACCESS_TOKEN=

# Portal API Key (OAuth client_id) — app id for authorize + token exchange.
# Prefer putting the Bearer only in UPSTOX_ACCESS_TOKEN.
UPSTOX_API_KEY=

# Portal API Secret (OAuth client_secret) — server-side token exchange only.
# Never commit. Not required for manual portal token → CLI sync.
UPSTOX_API_SECRET=

# OAuth redirect URI — must match Developer App config exactly (OAuth only).
# Local example (FastAPI oauth route):
# UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/callback/upstox
# Vercel Hobby free (live production project smallcase-sip-lab):
# UPSTOX_REDIRECT_URI=https://smallcase-sip-lab.vercel.app/callback/upstox
UPSTOX_REDIRECT_URI=

# Comma-separated extra browser origins for CORS (e.g. Vercel frontend).
# Local Next.js origins are always allowed.
# CORS_ORIGINS=https://your-app.vercel.app

# Optional overrides
# UPSTOX_API_BASE=https://api.upstox.com/v2
# UPSTOX_DEFAULT_YEARS=3

# Enable POST /integrations/upstox/sync (local only; prefer CLI / Make)
# UPSTOX_SYNC_ENABLED=0

# ── Kite Connect (equity holdings read-only — NOT a price source) ───────────
# Access token is NOT on the developer console. Daily login:
#   make kite-login → browser → make kite-exchange REQUEST_TOKEN=...
# Token expires ~6 AM IST next day. See docs/integrations/kite-connect.md
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
KITE_REDIRECT_URI=https://smallcase-sip-lab.vercel.app/callback/kite

# ── App ─────────────────────────────────────────────────────────────────────
# DATA_CURATED_ROOT=
# DEFAULT_RF=0.0
# PERIODS_PER_YEAR=252
