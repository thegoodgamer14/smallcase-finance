# ── Make / pipeline generated data ──────────────────────────────────────────
# Recreate with:  make pipeline  |  make data  |  make demo  |  make sync-upstox
#
# Curated analytical SoT (Parquet/CSV/JSON under data/curated/)
data/curated/**
!data/curated/**/
!data/curated/**/.gitkeep

# Generated / dropped price bulk folders (sample, upstox, broker, …)
data/raw/prices/**
!data/raw/prices/
!data/raw/prices/.gitkeep

# Generated / dropped instrument masters
data/raw/instruments/**
!data/raw/instruments/
!data/raw/instruments/.gitkeep

# Optional personal holdings exports
data/raw/holdings/**
!data/raw/holdings/
!data/raw/holdings/.gitkeep

# Live Kite portfolio snapshots (personal PII / positions)
data/curated/portfolio/**
!data/curated/portfolio/
!data/curated/portfolio/.gitkeep

*.parquet.bak
data/**/*.parquet.bak

